---
import { getDocsNav, urlOf } from "../../lib/docs";

interface Props {
  currentId?: string;
}

const { currentId } = Astro.props;
const nav = await getDocsNav();
---

<div data-sidebar-backdrop class="fixed inset-0 z-40 hidden bg-black/60 lg:hidden"></div>
<aside
  data-sidebar
  transition:persist="docs-sidebar"
  class="fixed inset-y-0 left-0 z-50 w-72 -translate-x-full overflow-y-auto border-r border-line bg-ink px-5 pb-10 pt-20 transition-transform data-[open]:translate-x-0 lg:sticky lg:top-14 lg:z-0 lg:h-[calc(100vh-3.5rem)] lg:w-64 lg:shrink-0 lg:translate-x-0 lg:bg-transparent lg:pt-8"
>
  <nav aria-label="Documentation" class="space-y-7">
    {
      nav.map((group) => (
        <div>
          <p class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-muted">{group.title}</p>
          <ul class="space-y-0.5">
            {group.entries.map((entry) => {
              const active = entry.id === currentId;
              return (
                <li>
                  <a
                    href={urlOf(entry)}
                    data-doc-link
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "block rounded-lg px-3 py-1.5 text-sm transition-colors",
                      active ? "bg-accent/12 font-medium text-accent" : "text-muted hover:bg-white/5 hover:text-fg",
                    ]}
                  >
                    {entry.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>

<script>
  const activeClasses = ["bg-accent/12", "font-medium", "text-accent"];
  const idleClasses = ["text-muted", "hover:bg-white/5", "hover:text-fg"];
  let listeners: AbortController | undefined;

  const initSidebar = () => {
    listeners?.abort();
    listeners = new AbortController();
    const { signal } = listeners;
    const sidebar = document.querySelector<HTMLElement>("[data-sidebar]");
    const backdrop = document.querySelector<HTMLElement>("[data-sidebar-backdrop]");
    const setOpen = (open: boolean) => {
      sidebar?.toggleAttribute("data-open", open);
      backdrop?.classList.toggle("hidden", !open);
    };
    setOpen(false);
    document.querySelector("[data-sidebar-toggle]")?.addEventListener("click", () => setOpen(true), { signal });
    backdrop?.addEventListener("click", () => setOpen(false), { signal });
    sidebar?.querySelectorAll<HTMLAnchorElement>("[data-doc-link]").forEach((link) => {
      const active = link.pathname === window.location.pathname;
      for (const name of activeClasses) link.classList.toggle(name, active);
      for (const name of idleClasses) link.classList.toggle(name, !active);
      if (active) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
      link.addEventListener("click", () => setOpen(false), { signal });
    });
    sidebar?.querySelector("[aria-current]")?.scrollIntoView({ block: "nearest" });
  };

  document.addEventListener("astro:page-load", initSidebar);
</script>
