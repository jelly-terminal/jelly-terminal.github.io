---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 1 && (
    <nav aria-label="On this page" class="sticky top-24 hidden w-52 shrink-0 self-start xl:block">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">On this page</p>
      <ul class="space-y-1.5 border-l border-line text-sm">
        {items.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-link
              class:list={[
                "-ml-px block border-l border-transparent py-0.5 text-muted transition-colors hover:text-fg",
                heading.depth === 3 ? "pl-6" : "pl-3",
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  let spy: IntersectionObserver | undefined;

  const initToc = () => {
    spy?.disconnect();
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
    const targets = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((target): target is HTMLElement => target !== null);
    spy = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (!visible) return;
        for (const link of links) {
          const active = link.hash === `#${visible.target.id}`;
          link.classList.toggle("text-accent", active);
          link.classList.toggle("border-accent", active);
        }
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );
    targets.forEach((target) => spy?.observe(target));
  };

  document.addEventListener("astro:page-load", initToc);
</script>
