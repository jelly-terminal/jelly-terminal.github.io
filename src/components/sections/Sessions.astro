---
import SectionHeader from "../ui/SectionHeader.astro";
import ScrollShowcase from "../islands/ScrollShowcase";
---

<section id="sessions" class="scroll-mt-14 border-t border-line px-6 py-24">
  <div class="mx-auto max-w-5xl">
