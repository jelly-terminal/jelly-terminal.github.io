---
import { AppleLogo } from "@phosphor-icons/react/ssr";
import { links } from "../../data/links";
---

<section class="border-t border-line px-6 py-28">
  <div data-reveal class="mx-auto flex max-w-xl flex-col items-center text-center">
    <img src="/logo.png" alt="" width="64" height="64" loading="lazy" class="size-16 rounded-2xl" />
    <h2 class="mt-6 font-display text-3xl font-semibold tracking-tight md:text-4xl">Give Jelly a try.</h2>
    <p class="mt-3 text-muted">Runs on macOS 26 and later, and keeps itself up to date.</p>
    <a href={links.download} class="mt-8 inline-flex items-center gap-2 rounded-lg bg-fg px-5 py-2.5 text-sm font-medium text-ink transition-opacity hover:opacity-90">
      <AppleLogo size={16} weight="fill" />
      Download for macOS
    </a>
  </div>
</section>
