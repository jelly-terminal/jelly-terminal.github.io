---
interface Props {
  src: string;
  alt: string;
  class?: string;
  eager?: boolean;
  width: number;
  height: number;
}

const { src, alt, width, height, class: className = "", eager = false } = Astro.props;
---

<figure class:list={["overflow-hidden", className]}>
  <img src={src} alt={alt} width={width} height={height} loading={eager ? "eager" : "lazy"} decoding="async" class="block h-auto w-full" />
</figure>
