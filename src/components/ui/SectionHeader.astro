---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="max-w-xl">
  <h2 data-reveal class="font-display text-3xl font-semibold tracking-tight text-balance md:text-4xl">{title}</h2>
  <p data-reveal style="--d:1" class="mt-4 leading-relaxed text-pretty text-muted">
    <slot />
  </p>
</header>
